{
  "name": "aimhi-deal-desk",
  "version": "1.0.0",
  "description": "AiMhi Deal Desk — branded underwriting, investor tools, products, and capital site.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "check": "node --check src/index.js && node --test",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply aimhi-deal-desk-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply aimhi-deal-desk-db --remote"
  },
  "dependencies": {
    "wrangler": "^4.131.0"
  }
}
